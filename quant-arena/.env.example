# =============================================================================
# quant-arena — environment template. Copy to `.env` and fill in.
# `.env` is git-ignored. NEVER commit real credentials.
# =============================================================================

# ---------------------------------------------------------------------------
# SAFETY FLAGS — broker defaults to IBKR PAPER. Live trading requires ALL THREE
# of the following to be changed, and the code still refuses live in Phase 1-4.
# ---------------------------------------------------------------------------
TRADING_MODE=paper                       # paper | live
LIVE_TRADING_ENABLED=false               # must be literally "true" for live
LIVE_TRADING_CONFIRMATION=               # must equal: I UNDERSTAND REAL MONEY IS AT RISK
KILL_SWITCH=false                        # true = governor rejects every new order

# ---------------------------------------------------------------------------
# Interactive Brokers Gateway (ghcr.io/gnzsnz/ib-gateway)
# Use your PAPER username (IBKR Client Portal > Settings > Paper Trading Account).
# ---------------------------------------------------------------------------
TWS_USERID=your_paper_username
TWS_PASSWORD=change_me
IB_GATEWAY_IMAGE=ghcr.io/gnzsnz/ib-gateway:stable   # pin a specific tag once verified
IB_HOST=ib-gateway                       # service name on quant-net
IB_PORT=4004                             # 4004 = paper relay inside quant-net (4003 = live; refused)
IB_CLIENT_ID=101
IB_EXPECTED_ACCOUNT_PREFIX=DU            # IBKR paper accounts start with "DU"
VNC_SERVER_PASSWORD=change_me            # optional: view the gateway GUI on localhost:5900
TIME_ZONE=America/New_York

# ---------------------------------------------------------------------------
# Existing host PostgreSQL. Docker Desktop exposes host-published ports to
# containers at host.docker.internal. Admin creds are used ONLY by the one-shot
# migration container to create the `quant_trading` DB and app role.
# ---------------------------------------------------------------------------
PG_HOST=host.docker.internal
PG_PORT=5432
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=change_me
QUANT_DB_NAME=quant_trading
QUANT_DB_USER=quant_app
QUANT_DB_PASSWORD=change_me_too

# ---------------------------------------------------------------------------
# Existing LiteLLM gateway & Qdrant
# ---------------------------------------------------------------------------
LITELLM_BASE_URL=http://host.docker.internal:4000
LITELLM_API_KEY=sk-change-me             # a LiteLLM virtual key scoped to this project
LITELLM_MODEL_RESEARCH=research-default  # model alias as defined in your LiteLLM config
QDRANT_URL=http://host.docker.internal:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=quant_
QDRANT_VECTOR_SIZE=1024                  # must match the embedding model chosen in Phase 3

# ---------------------------------------------------------------------------
# Market data (Phase 2)
# ---------------------------------------------------------------------------
POLYGON_API_KEY=
DATABENTO_API_KEY=

# ---------------------------------------------------------------------------
# Alerts — leave blank to disable a channel
# ---------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
